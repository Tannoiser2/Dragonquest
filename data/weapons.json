{
  "_source": "Weapons Chart 20.2 (pp. 24-25)",
  "_fields": {
    "hands": "1, 2 o 1-2 (a due mani: damage_mod +1)",
    "damage_mod": "aggiunto a D10; 'V' variabile, '*' dipende dalla sostanza",
    "range_hex": "gittata in esagoni; null = P (proibito)",
    "class": "A perforante, B tagliente, C contundente, null = nessuna ferita grave",
    "use": "R ranged, M melee, C close",
    "min_ps": "-1 danno per ogni punto sotto il minimo; niente Rank sotto il minimo",
    "min_md": "-5 Base Chance per ogni punto sotto il minimo; niente Rank sotto il minimo"
  },
  "notes": {
    "A": "Contro AG modificata 9-12 attacca 2 volte per Pulse senza penalita'; con AG <= 8 attacca 3 volte.",
    "B": "Non e' un'arma vera: animali con WP <= 10 fuggono se falliscono 4xWP. Nessun Rank.",
    "C": "Stordisce bersagli umani con Leather/Cloth/nessuna armatura: ogni colpo stordisce, 4+ danni effettivi = KO (Assassino da dietro: KO automatico).",
    "D": "Arma da lancio, ma con Spear Thrower usa le caratteristiche di quest'ultimo (missile).",
    "E": "Attacca in mischia fino a 2 esagoni: la zona di mischia include i primi esagoni della zona ranged.",
    "F": "Solo a cavallo.",
    "G": "Va caricata oltre che preparata: 1 Pass (fionda, archi, spear thrower, cerbottana), 2 Pass balestra (3 con Cranequin).",
    "H": "Fino a 3 dardi per Pulse su 1-3 bersagli senza penalita'.",
    "J": "Torna al lanciatore se non colpisce nulla.",
    "K": "Contiene sostanza alchemica incendiaria; esplode all'impatto. Se manca, direzione casuale (corto/lungo/sinistra/destra).",
    "L": "Entangle in mischia o a distanza; in Close combat funziona come Garotte.",
    "M": "Entangle solo a distanza; in Close combat come Garotte.",
    "N": "Entangle e danno nello stesso Pulse in mischia; in Close come Garotte. Puo' lasciare la frusta o liberare il bersaglio e tenerla.",
    "O": "Indossati sulle mani, non serve prepararli.",
    "P": "Strangola bersagli di taglia umana o minore. Assassino: dopo il primo colpo danneggia ogni Pulse finche' la vittima muore o lui subisce danni."
  },
